          }
        }
      }
    },
    "We grant you a personal, limited, non‑transferable, non‑exclusive license to install and use the App on Apple devices you own or control, strictly as permitted by these Terms and the Apple Standard EULA." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
