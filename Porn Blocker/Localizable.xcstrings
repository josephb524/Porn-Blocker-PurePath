        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app usa o recurso de bloqueio de conteúdo do Safari para bloquear sites de conteúdo adulto."
          }
        }
      }
    },
    "The server response was invalid." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serverantwort war ungültig."
