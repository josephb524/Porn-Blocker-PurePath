          }
        }
      }
    },
    "You are responsible for any custom keywords, domains, or rules you add. Do not use the App to block content unlawfully or to infringe third‑party rights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist für alle eigenen Stichwörter, Domains oder Regeln verantwortlich, die du hinzufügst. Verwende die App nicht, um Inhalte rechtswidrig zu blockieren oder Rechte Dritter zu verletzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres responsable de las palabras clave, dominios o reglas personalizadas que añadas. No uses la App para bloquear contenido de forma ilícita ni para infringir derechos de terceros."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é responsável por palavras-chave, domínios ou regras personalizadas que adicionar. Não use o App para bloquear conteúdo de forma ilegal ou para violar direitos de terceiros."
          }
        }
      }
    },
    "You must be legally able to enter into this agreement to use the App." : {
      "localizations" : {
        "de" : {
