          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguimos las mejores prácticas de la plataforma para el acceso a datos y no vendemos datos personales. Consulta la Política de privacidad para más detalles."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
